  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "build:player": "esbuild src/web.tsx --bundle --minify --outfile=../dist/projects/kitchin/player.js --define:process.env.NODE_ENV=\"\\\"production\\\"\"",
